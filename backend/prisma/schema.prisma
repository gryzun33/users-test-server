generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) 
  firstName String
  lastName  String
  height    Float
  weight    Float
  gender    String
  address   String
  photo     String?
  createdAt DateTime @default(now())  
}